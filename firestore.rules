rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function hasRole(r) {
      return signedIn() && role() == r;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // campaigns: versão pública, criada pelo curador a partir de um request.
    // Uma vez publicada, a campanha permanece com página própria visível pelo resto do
    // ciclo de vida (inclusive em repasse/encerramento), mesmo que suma da listagem do portal.
    match /campaigns/{campaignId} {
      allow read: if resource.data.status in
        ['publicado', 'meta_atingida', 'prazo_encerrado', 'repasse_pendente',
         'repassado', 'prestacao_publicada', 'encerrado'] ||
        hasRole('curador') || hasRole('financeiro') || isAdmin();
      allow write: if false;
    }

    // requests: pedido bruto, privado — nunca público.
    match /requests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.requerenteId == request.auth.uid ||
         hasRole('curador') || hasRole('assistente_social') || isAdmin());
      // Pedidos entram somente pela API do servidor, que valida consentimento,
      // campos e anexos antes de usar o Admin SDK.
      allow create: if false;
      allow update: if hasRole('curador') || isAdmin();
      allow delete: if false;
    }

    // A página pública busca uma projeção de doações no servidor. Não exponha
    // identificadores externos nem dados de doadores diretamente pelo SDK cliente.
    match /donations/{donationId} {
      allow read: if false;
      allow write: if false;
    }

    // transfers: comprovante e extrato só ficam públicos quando a campanha
    // correspondente já está com prestação de contas divulgada.
    match /transfers/{transferId} {
      allow read: if hasRole('financeiro') || isAdmin() ||
        get(/databases/$(database)/documents/campaigns/$(resource.data.campaignId))
          .data.status == 'prestacao_publicada';
      allow write: if false;
    }

    // atendimentos_sociais: prontuário do Serviço Social, sigiloso. Escrita só pela API.
    match /atendimentos_sociais/{caseId} {
      allow read: if hasRole('assistente_social') || isAdmin();
      allow write: if false;
    }

    // projetos e pontos: entram pela API pública como "pendente". As páginas públicas
    // leem pelo servidor só os aprovados e sem os contatos privados do responsável.
    match /projetos/{projectId} {
      allow read: if hasRole('editor_conteudo') || isAdmin();
      allow write: if false;
    }

    match /pontos/{pointId} {
      allow read: if hasRole('editor_conteudo') || isAdmin();
      allow write: if false;
    }

    match /noticias/{newsId} {
      allow read: if resource.data.status == 'publicado' || hasRole('editor_conteudo') || isAdmin();
      allow write: if false;
    }

    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // users: cada um lê/edita o próprio perfil; admin gerencia papéis.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
