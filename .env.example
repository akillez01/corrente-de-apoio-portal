# Firebase client SDK (público — exposto ao browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (servidor — nunca expor ao browser)
# JSON da chave de service account, em uma linha só.
FIREBASE_SERVICE_ACCOUNT_KEY=

# App Check (produção)
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Onde os anexos (laudos, comprovantes) ficam gravados no servidor.
# Em produção, aponte para um caminho fora do diretório da aplicação
# (não apagado em cada deploy), com backup incluído na rotina do servidor.
STORAGE_DIR=./.data/uploads

# Mercado Pago (Fase 1 — Pix)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Anexos em Cloudflare R2 (obrigatório na Vercel; se R2_BUCKET vazio, usa disco local/STORAGE_DIR)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Avisos de novos cadastros e pedidos (Resend; remetente precisa estar verificado)
SYSTEM_NOTIFICATION_EMAIL=daimesolidariedade@gmail.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=https://daimesolidariedade.org
